---
interface Props {
  id?: string;
  kicker: string;
  title: string;
  intro?: string;
}
const { id, kicker, title, intro } = Astro.props;
---

<header class="section-head reveal">
  <p class="kicker">{kicker}</p>
  <h2 class="section-title" id={id}>{title}</h2>
  {intro && <p class="section-intro">{intro}</p>}
</header>
